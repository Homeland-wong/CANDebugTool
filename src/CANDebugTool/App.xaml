<Application x:Class="CANDebugTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CANDebugTool.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 注册值转换器 -->
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <converters:ClassifyModeToTextConverter x:Key="ClassifyModeToTextConverter"/>
            <converters:CalcTypeToDisplayConverter x:Key="CalcTypeToDisplayConverter"/>
            <converters:EqualityConverter x:Key="EqualityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
