<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>CANDebugTool</AssemblyName>
    <RootNamespace>CANDebugTool</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>CAN Developer</Authors>
    <Product>CAN 调试工具</Product>
    <Description>基于周立功 USB-CAN 适配器的 CAN 总线调试工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\lib\ControlCAN.dll" Link="ControlCAN.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
