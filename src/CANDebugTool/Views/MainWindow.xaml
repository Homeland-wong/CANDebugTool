<Window x:Class="CANDebugTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CANDebugTool.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="CAN 调试工具"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: 标题栏 + 工作区 ═══ -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4,4,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="CAN 高级调试工具" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" v1.0" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="工作区:" VerticalAlignment="Center" Foreground="#CCC" Margin="0,0,6,0"/>
                    <Button Content="新建工作区" Style="{StaticResource SmallButton}" Command="{Binding WorkspaceVM.NewWorkspaceCommand}" Margin="0,0,4,0"/>
                    <Button Content="加载工作区" Style="{StaticResource SmallButton}" Command="{Binding WorkspaceVM.LoadWorkspaceCommand}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding WorkspaceVM.WorkspaceName}" VerticalAlignment="Center" Foreground="#AAA" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row 1: 设备控制条 ═══ -->
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,1,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 设备区 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="设备:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="160" ItemsSource="{Binding DeviceList}" SelectedItem="{Binding SelectedDevice}"
                              IsEnabled="{Binding IsDeviceConnected, Converter={StaticResource InverseBoolConverter}}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Command="{Binding ScanDevicesCommand}"
                            IsEnabled="{Binding IsDeviceConnected, Converter={StaticResource InverseBoolConverter}}" Padding="8,2" Margin="4,0,0,0"/>
                    <TextBlock Text="通道:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <ComboBox Width="60" SelectedValue="{Binding CanChannel}" SelectedValuePath="Content">
                        <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/>
                    </ComboBox>
                    <TextBlock Text="波特率:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <ComboBox Width="80" ItemsSource="{Binding BaudrateList}" SelectedItem="{Binding SelectedBaudrate}" DisplayMemberPath="Name"/>
                    <CheckBox Content="监听" IsChecked="{Binding SelectedBaudrate.ListenOnlyMode}" VerticalAlignment="Center" Margin="12,0,0,0"
                              ToolTip="只听模式：只接收不发送ACK，不参与总线仲裁"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="连接" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding IsDeviceConnected, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,4,0"/>
                    <Button Content="断开" Style="{StaticResource DangerButton}" Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding IsDeviceConnected}" Margin="0,0,4,0"/>
                    <Button Content="启动" Style="{StaticResource PrimaryButton}" Command="{Binding StartCanCommand}"
                            IsEnabled="{Binding IsCanRunning, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,4,0"/>
                    <Button Content="停止" Style="{StaticResource SecondaryButton}" Command="{Binding StopCanCommand}"
                            IsEnabled="{Binding IsCanRunning}" Margin="0,0,4,0"/>
                    <TextBlock Text="" VerticalAlignment="Center"/>
                    <CheckBox Content="暂停" IsChecked="{Binding IsPaused}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <!-- 捕获 / 录制指示 -->
                    <Ellipse Width="8" Height="8" Fill="#D13438" Margin="12,0,0,0" Opacity="{Binding IsCapturing, Converter={StaticResource BoolToOpacityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row 2: 主内容区 (报文 + 归类统计 + 曲线) ═══ -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─── 左上: 报文监控台 ─── -->
            <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 报文监控" FontSize="13" FontWeight="SemiBold" Margin="4,2"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ReceivedMessages}" FontSize="11">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransmit}" Value="False">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTransmit}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding SequenceNumber}" Width="45"/>
                            <DataGridTextColumn Header="时间戳(μs)" Binding="{Binding TimestampUs}" Width="85"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdDisplay}" Width="70"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding DirectionCn}" Width="35"/>
                            <DataGridTextColumn Header="帧类型" Binding="{Binding FrameTypeCn}" Width="40"/>
                            <DataGridTextColumn Header="DLC" Binding="{Binding DataLen}" Width="35"/>
                            <DataGridTextColumn Header="数据" Binding="{Binding DataHex}" Width="*" MinWidth="100"/>
                            <DataGridTextColumn Header="归类码" Binding="{Binding ClassifyCodeHex}" Width="110"/>
                            <DataGridTextColumn Header="组号" Binding="{Binding GroupId}" Width="35"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 底部工具栏: 快速发送 -->
                    <Grid Grid.Row="2" Margin="2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RxCount, StringFormat='RX: {0}'}" VerticalAlignment="Center" Foreground="#0078D4"/>
                        <TextBlock Grid.Column="1" Text=" | " Foreground="#DDD" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="快速发送:" VerticalAlignment="Center" FontSize="11" Foreground="#666"/>
                        <TextBlock Grid.Column="3" Text="ID:" VerticalAlignment="Center" FontSize="11" Margin="4,0,2,0"/>
                        <TextBox Grid.Column="4" Width="100" Text="{Binding SendVM.CanId, UpdateSourceTrigger=PropertyChanged}" FontSize="11" TextChanged="HexInput_TextChanged"/>
                        <TextBlock Grid.Column="5" Text="数据:" VerticalAlignment="Center" FontSize="11" Margin="6,0,2,0"/>
                        <TextBox Grid.Column="6" Width="170" Text="{Binding SendVM.CanData, UpdateSourceTrigger=PropertyChanged}" FontSize="11" TextChanged="HexInput_TextChanged"/>
                        <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="6,0,2,0">
                            <TextBlock Text="标准" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="#666"/>
                            <CheckBox Style="{StaticResource SliderToggleStyle}" IsChecked="{Binding SendVM.IsExtendedFrame}" VerticalAlignment="Center"/>
                            <TextBlock Text="扩展" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#666"/>
                        </StackPanel>
                        <Button Grid.Column="8" Content="发送" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendVM.SendCommand}" Padding="8,2" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─── 右上: 归类统计面板 ─── -->
            <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📊 归类统计" FontSize="13" FontWeight="SemiBold" Margin="4,2"/>
                    <!-- 掩码配置工具栏 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,2">
                        <Button Content="掩码规则" Style="{StaticResource SecondaryButton}" Command="{Binding StatisticsVM.ToggleRulePanelCommand}" Padding="8,2"/>
                        <Button Content="保存规则" Style="{StaticResource SecondaryButton}" Command="{Binding StatisticsVM.SaveRulesCommand}" Padding="8,2" Margin="4,0,0,0"/>
                        <Button Content="加载规则" Style="{StaticResource SecondaryButton}" Command="{Binding StatisticsVM.LoadRulesCommand}" Padding="8,2" Margin="4,0,0,0"/>
                        <TextBlock Text="{Binding StatisticsVM.StatusText}" VerticalAlignment="Center" Foreground="#666" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- 规则编辑面板（可折叠） -->
                    <Border Grid.Row="2" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="3"
                            Margin="2,0,2,2"
                            Visibility="{Binding StatisticsVM.IsRulePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,2">
                                <Button Content="+ 添加规则" Style="{StaticResource PrimaryButton}" Command="{Binding StatisticsVM.AddRuleCommand}" Padding="8,2" FontSize="11"/>
                                <TextBlock Text="归类码相同则归为同一组，不同规则也可能产生同归类码，组名为首个规则名，添加规则请谨慎！"
                                           Foreground="Red" FontWeight="Bold" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="180">
                                <ItemsControl ItemsSource="{Binding StatisticsVM.Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2,2" Padding="6,4" BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="3" Background="White">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Row 0: 标题栏 -->
                                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="配置" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="0,0,2,0"/>
                                                        <CheckBox Style="{StaticResource SliderToggleStyle}" IsChecked="{Binding IsClassifyMode}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="归类" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="2,0,4,0"/>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2,0,0,0" FontSize="11"/>
                                                        <Button Content="↺" Width="22" Height="22" FontSize="13" Padding="0" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.StatisticsVM.ResetRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="重置此规则统计">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                                    <Setter Property="Foreground" Value="#0078D4"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="0">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#0078D4"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="×" Width="22" Height="22" FontSize="13" Padding="0" Margin="2,0,0,0"
                                                                Command="{Binding DataContext.StatisticsVM.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="删除此规则">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                                    <Setter Property="Foreground" Value="#666"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="0">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#D13438"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                    <!-- Row 1 左: 掩码规则 -->
                                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="ID掩码:" FontSize="10" VerticalAlignment="Center" Foreground="#888"/>
                                                            <TextBox Text="{Binding IdMaskHex, UpdateSourceTrigger=LostFocus}" Width="65" FontSize="11" Margin="4,2" FontFamily="Consolas"
                                                                     IsReadOnly="{Binding IsClassifyMode}"/>
                                                            <TextBlock Text="等" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="6,0,2,0"/>
                                                            <CheckBox Style="{StaticResource SliderToggleLeftStyle}" IsChecked="{Binding IdOpEquals}" VerticalAlignment="Center"
                                                                      IsEnabled="{Binding IsClassifyMode}"/>
                                                            <TextBlock Text="不等" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="2,0,4,0"/>
                                                            <TextBlock Text="ref:" FontSize="10" VerticalAlignment="Center" Foreground="#888"/>
                                                            <TextBox Text="{Binding IdRefHex, UpdateSourceTrigger=LostFocus}" Width="65" FontSize="11" Margin="4,2" FontFamily="Consolas"
                                                                     IsReadOnly="{Binding IsClassifyMode}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                            <TextBlock Text="Data掩码:" FontSize="10" VerticalAlignment="Center" Foreground="#888"/>
                                                            <TextBox Text="{Binding DataMaskHex, UpdateSourceTrigger=LostFocus}" Width="120" FontSize="11" Margin="4,2" FontFamily="Consolas"
                                                                     IsReadOnly="{Binding IsClassifyMode}"/>
                                                            <TextBlock Text="等" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="6,0,2,0"/>
                                                            <CheckBox Style="{StaticResource SliderToggleLeftStyle}" IsChecked="{Binding DataOpEquals}" VerticalAlignment="Center"
                                                                      IsEnabled="{Binding IsClassifyMode}"/>
                                                            <TextBlock Text="不等" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="2,0,4,0"/>
                                                            <TextBlock Text="ref:" FontSize="10" VerticalAlignment="Center" Foreground="#888"/>
                                                            <TextBox Text="{Binding DataRefHex, UpdateSourceTrigger=LostFocus}" Width="120" FontSize="11" Margin="4,2" FontFamily="Consolas"
                                                                     IsReadOnly="{Binding IsClassifyMode}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!-- Row 1 中: 分隔线 -->
                                                    <Border Grid.Row="1" Grid.Column="1" Width="1" Margin="8,2" Background="#E0E0E0"/>
                                                    <!-- Row 1 右: 关注值配置 -->
                                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="关注值配置" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="#555"/>
                                                            <Button Content="+" Width="18" Height="18" FontSize="11" FontWeight="Bold" Padding="0" Margin="6,0,2,0"
                                                                    Command="{Binding DataContext.StatisticsVM.AddCalcConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding IsClassifyMode, Converter={StaticResource InverseBoolConverter}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                        <Setter Property="Cursor" Value="Hand"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="0">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#C8E6C9"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding CalcConfigs}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,2" Padding="3,1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Background="#FAFAFA">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBox Text="{Binding DataMaskHex, UpdateSourceTrigger=LostFocus}" Width="110" FontSize="10" FontFamily="Consolas"/>
                                                                            <TextBlock Text="小端" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="4,0,1,0"/>
                                                                            <CheckBox Style="{StaticResource SliderToggleStyle}" IsChecked="{Binding IsBigEndian}" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="大端" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="1,0,2,0"/>
                                                                            <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding PropertyType}" Width="80" FontSize="10">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding ., Converter={StaticResource CalcTypeToDisplayConverter}}" FontSize="10"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                            <ComboBox Width="44" FontSize="10" SelectedItem="{Binding FocusMode}" Margin="2,0,0,0">
                                                                                <sys:String>无</sys:String>
                                                                                <sys:String>增量</sys:String>
                                                                                <sys:String>跳动</sys:String>
                                                                            </ComboBox>
                                                                            <Button Content="-" Width="16" Height="16" FontSize="10" FontWeight="Bold" Padding="0" Margin="3,0,0,0"
                                                                                    Command="{Binding DataContext.StatisticsVM.RemoveCalcConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button">
                                                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                                        <Setter Property="Cursor" Value="Hand"/>
                                                                                        <Setter Property="Template">
                                                                                            <Setter.Value>
                                                                                                <ControlTemplate TargetType="Button">
                                                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="0">
                                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                                    </Border>
                                                                                                </ControlTemplate>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                        <Style.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#EF9A9A"/>
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <!-- 统计组列表 -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding StatisticsVM.Groups}" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="组号" Binding="{Binding GroupId}" Width="40"/>
                            <DataGridTextColumn Header="组名" Binding="{Binding RuleName}" Width="80"/>
                            <DataGridTextColumn Header="归类码" Binding="{Binding ClassifyCode}" Width="*" MinWidth="130"/>
                            <DataGridTextColumn Header="计数" Binding="{Binding Count}" Width="45"/>
                            <DataGridTemplateColumn Header="时间差(μs)" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeDiff}" TextAlignment="Right" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="最小(μs)" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeDiffMin, TargetNullValue=-}" TextAlignment="Right" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="最大(μs)" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeDiffMax, TargetNullValue=-}" TextAlignment="Right" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="关注值" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Results}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding CalcValue, StringFormat={}{0:F2}}" TextAlignment="Right" Margin="0,0,2,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PropertyTypeDisplay}" Foreground="#888" FontSize="10" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FocusedDeltaDisplay}" Foreground="#D13438" FontSize="10" Margin="0,0,2,0"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding FocusedMinDisplay}" Foreground="#0078D4" FontSize="10" Margin="0,0,2,0"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding FocusedMaxDisplay}" Foreground="#107C10" FontSize="10"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ─── 曲线行 (左下曲线显示 + 右下曲线配置, 3:1比例) ─── -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 曲线绘制区 (3/4) -->
                <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="📈 曲线" FontSize="13" FontWeight="SemiBold" Margin="4,2"/>
                            <TextBlock Text="(占位 - 后续实现)" Foreground="#999" VerticalAlignment="Center" Margin="8,0"/>
                        </StackPanel>
                        <!-- 显示宽度设置 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,4">
                            <TextBlock Text="显示宽度:" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                            <TextBox Width="80" Text="{Binding CurveVM.SelectedCurve.DisplayWidthPoints, UpdateSourceTrigger=PropertyChanged, FallbackValue=1000}" FontSize="11"/>
                            <TextBlock Text="点数" VerticalAlignment="Center" FontSize="11" Foreground="#888" Margin="4,0,0,0"/>
                        </StackPanel>
                        <!-- 曲线显示区域 -->
                        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="2" Margin="4">
                            <TextBlock Text="曲线绘制区域&#x0a;最多8条可缩放叠加曲线" Foreground="#CCC" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="20"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 曲线配置 (1/4) -->
                <Border Grid.Column="2" Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="曲线选择" FontSize="13" FontWeight="SemiBold" Margin="4,2"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CurveVM.Curves}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2,2" Padding="6,4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Name}" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                                                    <TextBlock Text="上限:" FontSize="10" Foreground="#888" VerticalAlignment="Center"/>
                                                    <TextBox Width="60" Text="{Binding UpperLimit, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Margin="4,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                                                    <TextBlock Text="下限:" FontSize="10" Foreground="#888" VerticalAlignment="Center"/>
                                                    <TextBox Width="60" Text="{Binding LowerLimit, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ Row 3: 数字显示区 ═══ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,6,0,0" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="🔢 数字显示" FontSize="13" FontWeight="SemiBold" Margin="2,2,0,4"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding DigitalVM.Displays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8" Rows="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="6,4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#666" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="Bold" Foreground="#0078D4" TextAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ═══ Row 4: 状态栏 ═══ -->
        <Border Grid.Row="4" Background="#F0F0F0" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Padding="10,4" Margin="0,4,0,0" CornerRadius="0,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 设备状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,4,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StatusDisconnected}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource StatusConnected}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="设备" FontSize="11"/>
                </StackPanel>
                <!-- CAN 状态 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,4,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StatusStopped}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCanRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource StatusRunning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="CAN" FontSize="11"/>
                </StackPanel>
                <!-- TX/RX 计数 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="TX:" Foreground="#107C10" FontSize="11"/>
                    <TextBlock Text="{Binding TxCount}" Width="50" FontSize="11"/>
                    <TextBlock Text="RX:" Foreground="#0078D4" FontSize="11" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding RxCount}" Width="50" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11" Foreground="#666"/>
                <!-- 处理耗时 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="处理耗时:" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="{Binding ProcessTimeUs, StringFormat='{}{0} μs'}" FontSize="11" Foreground="#888"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
